# نمونه‌ی nginx برای هم‌ورق. مسیر واقعی: /etc/nginx/sites-available/hamvaraq
# سه مقدار رو عوض کن: دامنه، مسیر پروژه، مسیر گواهی SSL

server {
    listen 80;
    server_name hamvaraq.ir www.hamvaraq.ir;

    location /.well-known/acme-challenge/ {
        alias /var/www/acme-challenge/;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name hamvaraq.ir www.hamvaraq.ir;

    ssl_certificate     /etc/ssl/hamvaraq/fullchain.pem;
    ssl_certificate_key /etc/ssl/hamvaraq/privkey.pem;

    client_max_body_size 12M;

    location /static/ {
        alias /home/ubuntu/hamvaraq/staticfiles/;
    }

    location /media/ {
        alias /home/ubuntu/hamvaraq/media/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
