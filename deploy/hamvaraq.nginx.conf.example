# نمونه‌ی nginx برای هم‌ورق. مسیر واقعی: /etc/nginx/sites-available/hamvaraq
# سه مقدار رو عوض کن: دامنه، مسیر پروژه، مسیر گواهی SSL

# فایل استاتیکِ هش‌دار (app.3f2a….css) هیچ‌وقت عوض نمی‌شه: یه سال immutable. بی‌هش (app.css که سرویس‌ورکر می‌گیره، فونت صفحه‌ی خطا): یه روز
map $uri $hamvaraq_static_cache {
    ~\.[0-9a-f]{12}\.[a-z0-9]+$ "public, max-age=31536000, immutable";
    default                     "public, max-age=86400";
}

server {
    listen 80;
    server_name hamvaraq.ir www.hamvaraq.ir;

    location /.well-known/acme-challenge/ {
        alias /var/www/acme-challenge/;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name hamvaraq.ir www.hamvaraq.ir;

    ssl_certificate     /etc/ssl/hamvaraq/fullchain.pem;
    ssl_certificate_key /etc/ssl/hamvaraq/privkey.pem;

    client_max_body_size 12M;

    # وقتی برنامه داره دوباره بالا میاد (آپدیت/ری‌استارت)، به‌جای 502 خام nginx صفحه‌ی «در حال به‌روزرسانی» نشون داده می‌شه.
    # این فایل‌ها مستقیم از پوشه‌ی static ریپو خونده می‌شن (نه staticfiles) تا حتی وقتی collectstatic اجرا نشده هم باشن.
    error_page 502 503 /errors/maintenance.html;
    # 504 یعنی برنامه بالاست ولی از شلوغی تو مهلت جواب نداد؛ پیام «در حال به‌روزرسانی» اونجا گمراه‌کننده‌ست
    error_page 504 /errors/busy.html;
    location ^~ /errors/ {
        root /home/ubuntu/hamvaraq/static;
        internal;
    }

    location /static/ {
        alias /home/ubuntu/hamvaraq/staticfiles/;
        error_page 404 /errors/404.html;
        # collectstatic (WhiteNoise) کنار هر فایل نسخه‌ی .gz رو هم می‌سازه؛ nginx همونو بدون مصرف CPU می‌فرسته
        gzip_static on;
        add_header Cache-Control $hamvaraq_static_cache;
    }

    location /media/ {
        alias /home/ubuntu/hamvaraq/media/;
        error_page 404 /errors/404.html;
    }

    # کارت‌های استوری: Django بعد از اولین رندر فقط هدر X-Accel-Redirect می‌فرسته و nginx فایل رو می‌ده.
    # تو .env بذار: CARD_X_ACCEL_PREFIX=/_cards/
    location /_cards/ {
        internal;
        alias /home/ubuntu/hamvaraq/media/cards/;
        expires 5m;
    }

    location / {
        proxy_pass http://127.0.0.1:8001;   # WEB_PORT تو .env (روی سرور مشترک با پروفام)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;  # آی‌پی واقعی برای محدودیت نرخ
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
